				GetPlayerPos(playerid,X,Y,Z);
				PlayerPlaySound(playerid,1056,X,Y,Z);
				return 1;
			}
			else
			{
				//SCM(playerid,COLOR_SINA3,"There is no vehicle or You haven't key of this vehicle.");
				return 1;
