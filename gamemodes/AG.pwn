							{
								BizzInfo[i][bBuyPrice] = proplev;
							}
							else if(strcmp(x_job,"EntrancePrice",true) == 0)
							{
								BizzInfo[i][bEntranceCost] = proplev;
							}
							else if(!strcmp(x_job, "PriceProd", true))
							{
								BizzInfo[i][bPriceProd] = proplev;
							}
							else if(!strcmp(x_job, "Prods", true))
