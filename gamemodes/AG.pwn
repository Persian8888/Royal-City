					SaveKonVal(i, "pPunish", PINFO[i][pPunish]);
				}
				/*
					if(PINFO[i][pSoldier] != 0 && AFK[i] == 0) {
					PINFO[i][pSoldier] -= 1;
					SaveKonVal(i, "pSoldier", PINFO[i][pSoldier]);
