					PlayerInfo[i][pTow] += 5;
					SaveKonVal(i, "pTow", PINFO[i][pTow]);
				}
				if(PlayerInfo[i][pCarLicS] > 0)
				{
					PlayerInfo[i][pCarLicS]--;
					SaveKonVal(i, "pCarLicS", PINFO[i][pCarLicS]);
