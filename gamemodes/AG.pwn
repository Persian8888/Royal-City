{
if(gPlayerLogged[playerid] != 0)
{
if(PINFO[playerid][pAdmin] >= 1 || PINFO[playerid][pHelper] >= 1 || PINFO[playerid][pLeader] >= 1)
{
SCM(l, COLOR_Good, "You have a new message in your messages box.");
}
}
}
}
