				if(PlayerInfo[target][pRank] == 1) { rtext = "Piccioto"; }
				else if(PlayerInfo[target][pRank] == 2) { rtext = "Soldato"; }
				else if(PlayerInfo[target][pRank] == 3) { rtext = "Sgarrista"; }
