	SendRobMessage(COLOR_ROB, svsvs);
	SendRobMessage(COLOR_ROB, "Rob mission failed.");
	StopRob();
	}
	}
	}
/*	if(OnPaintBall[playerid] == 0 && OnWar[playerid] == 9999 && (!IsACop(playerid) || (OnDuty[playerid] == 0 && IsACop(playerid))) && Reside[playerid] == 0) {
