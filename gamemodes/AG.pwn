					SaveKonValH(bouse, "hRentabil", 0);
					SCM(playerid,COLOR_SINA3,"Rentable of home Disabled.");
					CustomPickups();
					}
					else return SendMessage(playerid, COL_SYN, "Syntax: /setrentable <On/Off>");
