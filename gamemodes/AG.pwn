					else
					{
						SendMessage(playerid, COLOR_GRAD1, "No Such Player");
					}
				}
				else
				{
					SendMessage(playerid, COLOR_YELLOW, "Error: Your admin level isn't high enough to use this command");
				}
			}
			return 1;
		}
