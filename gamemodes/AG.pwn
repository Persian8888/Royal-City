		if(!PTP(2.0,playerid,244.331329,118.533126,1003.218750)) return SCM(playerid,COLOR_BLUE,"You are not in Police Armoury(equip place)");
		if(OnDuty[playerid] == 0) return SCM(playerid,COLOR_BLUE,"You are not On-Duty");
		new strgun[150];
