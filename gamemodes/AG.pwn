						return 1;
					}
				if(PlayerInfo[playerid][pAdmin] == 7) return SCM(playerid, COLOR_YELLOW2, "Error: You can't use this command.");
				if(PlayerInfo[playerid][pAdmin] == 8) return SCM(playerid, COLOR_YELLOW2, "Error: You can't use this command.");
