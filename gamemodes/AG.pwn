						SendMessage(playerid, COL_SYN, "Syntax: /Atmwithdraw <Amount>");
						return 1;
					}
					if (cashdeposit > PlayerInfo[playerid][pAccount] || cashdeposit < 1)
					{
						SendMessage(playerid, COLOR_GRAD2, "You dont have that much.");
						return 1;
