forward robanti(playerid);
public robanti(playerid) {
RobBug[playerid] = 0;
return 1;
}
public OnPlayerLeaveCheckpoint(playerid)
{
if(FCNPC_IsValid(playerid)) return 1;
if(ImInCP[playerid]==1)ImInCP[playerid]=0;
	return 1;
}

