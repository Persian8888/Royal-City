GetFacNameNoColor(facid)
{
	new FacName[32];
	switch(facid)
	{
		case 5: FacName = "DNB";
		case 6: FacName = "Triads";
		case 12: FacName = "GroveStreet";
		case 13: FacName = "Vagos";
		case 14: FacName = "TBF";
		case 15: FacName = "VLA";
