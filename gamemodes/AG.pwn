									CustomPickups();
							 format(strr, sizeof(strr), "[Admin-Warn]:{FFFFFF} Admin %s has been just edited House ID %d's %s to %s.", PINFO[playerid][pName], i, x_job, Amountt);
							 ABroadCast(COLOR_AdminWarn,strr,1);
