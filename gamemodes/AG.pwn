	   vInfo[r][cMod17] = 0;
	   SaveKonValV(r, "cMod17", 0);
	   vInfo[r][cPaintJob] = 3;
	   SaveKonValV(r, "cPaintJob", 3);
	   vInfo[r][cPanel] = 0;
	   SaveKonValV(r, "cPanel", 0);
	   vInfo[r][cDoors] = 0;
	   SaveKonValV(r, "cDoors", 0);
	   vInfo[r][cTires] = 0;
	   SaveKonValV(r, "cTires", 0);
