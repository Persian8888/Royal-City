	{
		if(CameraPoint[playerid]<=1) return true;
		CameraPoint[playerid]--;
		new Float:Cam[5];
		GetPlayerPos(playerid, Cam[0],Cam[1],Cam[2]);
		GetXYInFrontOfPlayer(playerid,Cam[3],Cam[4],CameraPoint[playerid]);
