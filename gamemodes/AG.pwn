	   if(PlayerInfo[i][pMember] == 2 || PlayerInfo[i][pLeader] == 2) { ttext = "{0000CC}Federal Bureau of Investigation"; }
		else if(PlayerInfo[i][pMember] == 1 || PlayerInfo[i][pLeader] == 1) { ttext = "{0000ff}Police Departament"; }
