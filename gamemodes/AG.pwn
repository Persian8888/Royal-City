				else if(PlayerInfo[target][pRank] == 6) { rtext = "Consigliere"; }
				else if(PlayerInfo[target][pRank] == 7) { rtext = "Don The Killers"; }

			}
			else if(PlayerInfo[target][pMember] == 7 || PlayerInfo[target][pLeader] == 7)//Mayor ranks
