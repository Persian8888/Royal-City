ReturnUserEx(string[])//By SiNaGaMeR
{
	new Name[MAX_PLAYER_NAME],ID = INVALID_PLAYER_ID;
	for(new i = 0; i < Akharish; i++)
	{
	   if(IsPlayerConnected(i))
	   {
		  GetPlayerName(i, Name, MAX_PLAYER_NAME);
		  if(!strcmp(Name,string,true)) ID = i;
	   }
	}
	return ID;
}
