				if(PlayerInfo[target][pRank] == 1) { rtext = "Private"; }
				else if(PlayerInfo[target][pRank] == 2) { rtext = "Candidate Fire Paramedic"; }
				else if(PlayerInfo[target][pRank] == 3) { rtext = "Fire Paramedic"; }
