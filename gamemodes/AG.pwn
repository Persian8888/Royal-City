	/*----------------------------------------------------------------------------*/
	if(strcmp(cmd,"/stopanim",true)==0)
	{
		if(IsPlayerConnected(playerid) && GetPlayerAnimationIndex(playerid) && AnimPlay[playerid] == 1)
		{
			StopLoopingAnim(playerid);
			AnimPlay[playerid] = 0;
		}
		if(!GetPlayerAnimationIndex(playerid) && AnimPlay[playerid] == 1)
		{
		AnimPlay[playerid] = 0;
		}
		return 1;
	}
