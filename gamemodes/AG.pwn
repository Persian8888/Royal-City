	return 1;
	}
	}
	   SetPlayerGravity(id,amount);
	   format(str,sizeof(str),"[Admin-Warn]: {FFFFFF}Admin %s has changed %s's gravity to %f.",PlayerInfo[playerid][pName],PlayerInfo[id][pName],amount);
	   SendAdminMessage(COLOR_AdminWarn,str);
