					if(IsPlayerInVehicle(playerid, tcc1) || IsPlayerInVehicle(playerid, tcc2) || IsPlayerInVehicle(playerid, tcc3) || IsPlayerInVehicle(playerid, tcc4) || IsPlayerInVehicle(playerid, tcc5))
