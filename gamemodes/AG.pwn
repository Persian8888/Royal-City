	   vInfo[r][cMod5] = 0;
	   SaveKonValV(r, "cMod5", 0);
	   vInfo[r][cMod6] = 0;
	   SaveKonValV(r, "cMod6", 0);
	   vInfo[r][cMod7] = 0;
	   SaveKonValV(r, "cMod7", 0);
	   vInfo[r][cMod8] = 0;
	   SaveKonValV(r, "cMod8", 0);
	   vInfo[r][cMod9] = 0;
