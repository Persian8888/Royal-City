                if(IsAdv(result)&&PINFO[playerid][pAdmin]<12){new adwn[144];format(adwn, sizeof(adwn), "{ffffff}Player %s(%i) is advertising an IP (Possibly IP Address)",RPName(playerid), playerid);AdminWarn(adwn);}
				new tedad = 0;
		for(new b = 0;b < 9;b++) {
		new str[512];
