								getdate(dd,mm,yyyy);
								gettime(ore,mn,sec);
								format(strinxg,sizeof(strinxg), "%s%d/%s%d/%s%d  %s%d:%s%d", (dd < 10) ? ("0") : (""),dd, (mm < 10) ? ("0") : (""),mm, (yyyy < 10) ? ("0") : (""),yyyy, (ore < 10) ? ("0") : (""),ore,(mn < 10) ? ("0") : (""),mn);
								new query[512];
