				{
				if(PINFO[playerid][pRank] == 0 && PINFO[playerid][pMember] != 0) return SCM(playerid, COLOR_YELLOW, "You cannot togwhisper when you are in faction employ test.");
					if (HidePM[playerid] == 0)
