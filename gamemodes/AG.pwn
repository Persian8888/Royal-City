				GoBack1[playerid][1] = GetPlayerVirtualWorld(playerid);
				GoBack1[playerid][2] = Mahal[playerid];
				GoBack1[playerid][3] = TooHouse[playerid];
				GoBack1[playerid][4] = TooBiz[playerid];
