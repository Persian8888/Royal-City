stock SendFamilyMessage(family, color, string[], string2[] = "")
{
	#pragma unused string2
	for(new i = 0; i < Akharish; i++)
	{
	   if(IsPlayerConnected(i) && gPlayerLogged[i] == 1)
	   {
		  if(PlayerInfo[i][pMember] == family || PlayerInfo[i][pLeader] == family)
		  {
			 if(!gFam[i])
