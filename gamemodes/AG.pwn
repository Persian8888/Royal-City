			new price = strval(tmp);
			if(price <= -1 || price >= 50000001) return SCM(playerid,COLOR_YELLOW2,"Error: Invalid price.");
			if(biz >= 500)
			{
				if(price == 0)
				{
					SBizzInfo[biz-500][sbOwned] = 1;
					SBizzInfo[biz-500][sbForosh] = 0;
					OnSbizUpdate(biz-500);
					CustomPickups();
