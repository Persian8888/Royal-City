				{
					TurfTimerEx[OnWar[playerid]] -= 60;
					minbaghi ++;
					new minebaghi = minbaghi*60;
					secbaghi = TurfTime[OnWar[playerid]]-minebaghi;
				}
			}
			if(TurfTime[OnWar[playerid]] < 60) { minbaghi = 0; secbaghi = TurfTime[OnWar[playerid]]; }
