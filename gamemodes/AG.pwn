FixDay()
{
	new query[ 512 ];
	mysql_format(handle, query,512,"SELECT * FROM `users` WHERE `pPDay` > '0' AND `pPDay` != '9999'");
	mysql_format(handle, query,512,"SELECT * FROM `users` WHERE `pHDay` > '0' AND `pHDay` != '9999'");
	mysql_function_query(handle,query,true,"FixDayP","");
