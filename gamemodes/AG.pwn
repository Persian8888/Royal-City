	SendRconCommand(tabdilx);// By SiNaGaMeR
	SendRconCommand("mapname LS-LV-SF");// By SiNaGaMeR
	gettime(ghour, gminute, gsecond);
	FixHour(ghour);
	ghour = shifthour;
	AllowInteriorWeapons(1);
	UsePlayerPedAnims();
	DisableInteriorEnterExits();
	EnableStuntBonusForAll(0);


