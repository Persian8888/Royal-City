cache_get_field_content(0,"pSecQuestion",check1,handle,sizeof(check1));
cache_get_field_content(0,"pAnsQuestion",check2,handle,sizeof(check2));
levelx = cache_get_field_content_int(0,"pLevel");
HashEmail(emailx, Hasher);
