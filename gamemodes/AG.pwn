					}
					else if (gFam[playerid])
					{
						gFam[playerid] = 0;
						SCM(playerid, COLOR_GRAD2, "Family chat channel Enabled.");
					}
				}
				else
				SCM(playerid, COLOR_RED, "You haven't premium account");
			}
			return 1;
		}
		if(strcmp(cmd, "/togwhisper", true) == 0)
