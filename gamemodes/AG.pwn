			{
				car = strval(tmp);
				if(car < 400 || car > 615) return SEM(playerid, "Vehicle number should between 400 to 611.");
			}
			else
			{
				for(new i = 0;i<212;i++)
				{
					if(strfind(aVehicleNames[i], tmp, true) != -1)
					{
						car = i+400;
					}
				}
			}
