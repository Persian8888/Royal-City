	   SaveKonValV(r, "cLights", 0);
	   if(vInfo[r][cNeon] != 0)
	   {
	   VehicleNeon[vehicleid] = 0;
	   for(new i = 0; i < 24; i++)
	   {
		DestroyObject(CarNeons[vehicleid][i]);
	   }
	   }
	   if(vInfo[r][cInsurance] <= 0)
	   {
		  vInfo[r][cFixed] = 0;
