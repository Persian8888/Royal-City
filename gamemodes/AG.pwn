	if(IsPlayerConnected(playerid) && PlayDeathingCameraE[playerid] == false)
	{
	new Float:H;
	GetPlayerHealth(playerid,H);
	   if(Koon[playerid] < H)
	   {
		  SetPlayerKoon(true, playerid, Koon[playerid]);
	   }
	}
}
