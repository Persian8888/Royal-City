						SendMessage(playerid, COLOR_GRAD2, string);
						if(proplev > 0)
						{
							if(strcmp(x_job,"level",true) == 0)
							{
								SBizzInfo[i][sbLevelNeeded] = proplev;
							}
							else if(strcmp(x_job,"price",true) == 0)
							{
								SBizzInfo[i][sbBuyPrice] = proplev;
							}
