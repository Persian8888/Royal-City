function FinishCountDown(){if(countdown!=0){countdown=0;}}
function StopTheEvent()
{
KillTimer(EventStopper);
StopEvent(9999, "Time limit reached", true);
}
function svuptime()
{
	if(svsec >= 60)
	{
	svsec = 0;
	svmin++;
	}
	if(svmin >= 60)
	{
	svmin = 0;
	svhour++;
	}
	if(svhour == 24)
	{
	svhour = 0;
	svday++;
	}
	svsec++;
	return 1;
}
