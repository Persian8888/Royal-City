format(NaneJoon,60,"%s%d.%s%d.%s%d %s%d:%s%d",(year < 10) ? ("0") : (""),year,(month < 10) ? ("0") : (""),month,(day < 10) ? ("0") : (""),day,(hour < 10) ? ("0") : (""),hour,(minute < 10) ? ("0") : (""),minute);
